{
  "name": "@nassim-arifette/jevgrep",
  "version": "0.2.0",
  "description": "Semantic code search for coding agents: evaluates authorized repository fragments with Jev and returns original excerpts under a response budget.",
  "type": "module",
  "license": "MIT",
  "author": "Nassim Arifette",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nassim-arifette/jevgrep.git"
  },
  "homepage": "https://github.com/nassim-arifette/jevgrep#readme",
  "bugs": {
    "url": "https://github.com/nassim-arifette/jevgrep/issues"
  },
  "keywords": [
    "jev",
    "semantic-search",
    "code-search",
    "coding-agents",
    "mcp",
    "cli",
    "typesafe"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "bin": {
    "jevgrep": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json && node scripts/make-executable.ts",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "node --test \"tests/*.test.ts\" \"tests/contract/*.test.ts\"",
    "smoke": "node scripts/smoke.ts",
    "bench": "node scripts/bench.ts",
    "bench:cache": "node scripts/bench-cache-writes.ts",
    "bench:preparation": "node scripts/bench-preparation.ts",
    "bench:retrieval": "node scripts/bench-retrieval.ts",
    "bench:real": "node scripts/bench-real.ts",
    "bench:real:import": "node scripts/bench-real-import.ts",
    "bench:agent": "node scripts/bench-agent.ts",
    "bench:compare": "node scripts/bench-compare.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run smoke",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.87",
    "ai": "7.0.107",
    "tiktoken": "1.0.22",
    "typescript-parser": "npm:typescript@6.0.2"
  }
}
